    { "stage": "resize", "params": { "w": 750, "h": 422, "fit": "inside", "flags": "area" } },
    { "stage": "codec_roundtrip", "params": { "codec": "mjpeg", "q": 13, "container": "mp4" } },
    { "stage": "chroma_decimate", "params": { "to": "420" } },
