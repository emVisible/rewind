{
  "id": "vhs1990_static",
  "name": "VHS 家用录像带(静态近似)",
  "era": 1990,
  "schema": 1,
  "note": "ffmpeg 可达的静态近似。S4 信号级模拟(行撕裂/色度串扰/head-switching)由 ntscrs crate 在 M2 替换此预设内核。vignette 已移除(窥镜效应,不符合 VHS 介质)",
  "video": [
    {
      "stage": "chroma_decimate",
      "params": {
        "to": "411"
      }
    },
    {
      "stage": "matrix_roundtrip",
      "params": {}
    },
    {
      "stage": "resize",
      "impl": "ffmpeg",
      "params": {
        "w": 720,
        "h": 480,
        "flags": "bicubic"
      }
    },
    {
      "stage": "asymmetric_lowpass",
      "impl": "ffmpeg",
      "params": {
        "luma_radius": 1.5,
        "chroma_radius": 6
      }
    },
    {
      "stage": "noise",
      "impl": "ffmpeg",
      "params": {
        "alls": 10,
        "allf": "t+u"
      }
    },
    {
      "stage": "color",
      "impl": "ffmpeg",
      "params": {
        "saturation": 0.82,
        "contrast": 1.06
      }
    },
    {
      "stage": "interlace_comb",
      "impl": "ffmpeg",
      "params": {
        "mode": "merge",
        "refps": 30
      }
    },
    {
      "stage": "tape_ends",
      "params": {
        "head": 0.6,
        "tail": 0.6,
        "intensity": 30
      }
    }
  ],
  "audio": [
    {
      "stage": "bandlimit",
      "params": {
        "highpass": 120,
        "lowpass": 8000
      }
    },
    {
      "stage": "wow_flutter",
      "params": {
        "freq": 0.7,
        "depth": 0.02
      }
    },
    {
      "stage": "mono",
      "params": {}
    },
    {
      "stage": "tape_hiss",
      "params": {
        "color": "pink",
        "amplitude": 0.015,
        "mix_weight": 0.5
      }
    }
  ],
  "calibrated": "2026-10-04 M0,双片源目检通过(samples/out_vhs1990s_*.mp4)",
  "variant_of": "vhs1990_ntscrs",
  "variant": "静态近似"
}
